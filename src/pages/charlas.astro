---
import Base from '../layouts/Base.astro';
import { cargarCharlas, materialCharla } from '../lib/datos';

const charlas = cargarCharlas().map((c) => ({ ...c, material: materialCharla(c) }));
---

<Base titulo="Charlas" descripcion="Charlas y conferencias de César Augusto Vega Fernández.">
  <div class="contenedor">
    <header class="encabezado-pagina">
      <h1>Charlas</h1>
      <p>Charlas y conferencias, con el evento o contexto, el año y el material cuando está disponible.</p>
    </header>

    <ul class="lista">
      {
        charlas.map((c) => (
          <li class="elemento">
            <h2 class="elemento__titulo">{c.titulo}</h2>
            <p class="elemento__datos">
              {c.evento ? <span>{c.evento}</span> : <span class="pendiente">Evento por completar</span>}
              {c.lugar && <span>{c.lugar}</span>}
              <span>{c.anio}</span>
            </p>
            {c.material && (
              <p class="elemento__enlace">
                <a href={c.material.href}>Ver material</a>
                {c.material.formato && <span class="formato">{c.material.formato}</span>}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 52rem;
  }

  .elemento {
    padding-block: 1.25rem;
    border-top: 1px solid var(--borde);
  }

  .elemento:last-child {
    border-bottom: 1px solid var(--borde);
  }

  .elemento__titulo {
    font-size: 1.3rem;
    margin-bottom: 0.35rem;
  }

  .elemento__datos {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    color: var(--texto-suave);
  }

  .elemento__datos span + span::before {
    content: '·';
    margin-inline: 0.5rem;
  }

  .pendiente {
    font-style: italic;
  }

  .elemento__enlace {
    margin: 0.5rem 0 0;
  }
</style>
