---
import Base from '../layouts/Base.astro';
import { cargarPerfil } from '../lib/datos';

const perfil = cargarPerfil();

const accesos = [
  {
    href: '/cursos/',
    titulo: 'Cursos',
    texto: 'Cursos de pregrado y de la Maestría en Ingeniería de Software, con sus módulos, presentaciones y talleres.',
  },
  {
    href: '/charlas/',
    titulo: 'Charlas',
    texto: 'Charlas presentadas en eventos y temas de charla disponibles.',
  },
  {
    href: '/semilleros/',
    titulo: 'Semilleros',
    texto: 'Semilleros y grupos estudiantiles que acompaña, con sus actividades y su material.',
  },
];
---

<Base>
  <section class="contenedor presentacion" aria-labelledby="nombre">
    <p class="etiqueta">Profesor</p>
    <h1 id="nombre">{perfil.nombre}</h1>
    <p class="afiliacion">{perfil.afiliacion}</p>
    <p class="resumen">{perfil.resumen}</p>

    {
      perfil.presentacion.length > 0 ? (
        <div class="texto bio">
          {perfil.presentacion.map((parrafo) => (
            <p>{parrafo}</p>
          ))}
        </div>
      ) : (
        <div class="pendiente" role="note">
          <p class="pendiente__titulo">Texto por completar</p>
        </div>
      )
    }
  </section>

  <section class="contenedor accesos" aria-labelledby="titulo-accesos">
    <h2 id="titulo-accesos" class="visualmente-oculto">Secciones</h2>
    <ul class="accesos__lista">
      {
        accesos.map((a) => (
          <li>
            <a class="acceso" href={a.href}>
              <span class="acceso__titulo">{a.titulo}</span>
              <span class="acceso__texto">{a.texto}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .presentacion {
    padding-block: 3.5rem 2rem;
  }

  .presentacion h1 {
    font-size: clamp(2.1rem, 1.5rem + 2.6vw, 3.1rem);
    margin-bottom: 0.3em;
  }

  .afiliacion {
    font-size: 1.15rem;
    color: var(--texto);
    margin-bottom: 0.4rem;
  }

  .resumen {
    max-width: var(--ancho-texto);
    font-size: 1.125rem;
    color: var(--texto-suave);
  }

  .presentacion::after {
    content: '';
    display: block;
    width: 3.5rem;
    height: 3px;
    margin-top: 2rem;
    background: var(--acento);
  }

  .bio {
    margin-top: 1.5rem;
  }

  .pendiente {
    max-width: var(--ancho-texto);
    margin-top: 1.75rem;
    padding: 1rem 1.25rem;
    border: 2px dashed var(--borde);
    border-radius: var(--radio);
    background: var(--fondo-suave);
  }

  .pendiente__titulo {
    font-weight: 600;
    color: var(--acento-texto);
    margin: 0;
  }

  .accesos {
    padding-block: 1rem 2rem;
  }

  .accesos__lista {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .acceso {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.5rem;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-top: 4px solid var(--marino);
    border-radius: var(--radio);
    box-shadow: var(--sombra);
    color: var(--texto);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .acceso:hover {
    color: var(--texto);
    border-top-color: var(--acento);
  }

  .acceso__titulo {
    font-family: var(--serif);
    font-size: 1.45rem;
    color: var(--enlace);
  }

  .acceso:hover .acceso__titulo {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .acceso__texto {
    color: var(--texto-suave);
  }

  @media (prefers-color-scheme: dark) {
    .acceso {
      border-top-color: var(--enlace);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .acceso {
      transition: none;
    }
  }
</style>
